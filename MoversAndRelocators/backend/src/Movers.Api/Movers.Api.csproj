<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Message codes for the client (built by tools/i18n/extract-server-messages.mjs). -->
    <EmbeddedResource Include="Localization/server-messages.json" LogicalName="Movers.Api.Localization.server-messages.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.55.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Movers.Domain\Movers.Domain.csproj" />
    <ProjectReference Include="..\Movers.Services\Movers.Services.csproj" />
    <ProjectReference Include="..\Movers.DAL\Movers.DAL.csproj" />
  </ItemGroup>

</Project>
